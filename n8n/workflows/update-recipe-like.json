      "parameters": {
        "jsCode": "const likeRequest = $('Validate recipe like').first().json;\nconst rawResponse = $input.first().json;\nconst likeResult = Array.isArray(rawResponse) ? rawResponse[0] : rawResponse;\nconst likesCount = Number(likeResult?.likes_count);\nconst found = likeResult?.recipe_id === likeRequest.recipeId && Number.isInteger(likesCount);\nconst responseBody = found\n  ? {\n      success: true,\n      recipeId: likeRequest.recipeId,\n      liked: likeRequest.liked,\n      likesCount,\n    }\n  : {\n      success: false,\n      code: 'RECIPE_NOT_FOUND',\n      message: 'The requested public recipe could not be found.',\n    };\n\nreturn [{ json: { found, responseBody } }];"
      },
